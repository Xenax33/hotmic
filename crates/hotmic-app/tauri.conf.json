{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotmic",
  "version": "0.1.0",
  "identifier": "dev.hotmic.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hotmic",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 540,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
